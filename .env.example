# After installation, generate a private API_TOKEN with: etlab-api token
# Setup and mode selection: docs/getting-started.md
# In multiuser mode leave ETLAB_USERNAME and ETLAB_PASSWORD empty.
API_TOKEN=
APP_MODE=personal
ETLAB_BASE_URL=https://sahrdaya.etlab.in
ETLAB_USERNAME=
ETLAB_PASSWORD=
# ETLab subdomains are permitted by default. Add exact custom hostnames if needed.
ETLAB_ALLOWED_HOSTS=*.etlab.in
ETLAB_ATTACHMENT_HOSTS=
CACHE_TTL_SECONDS=60
CACHE_MAX_BYTES=8388608
SESSION_IDLE_SECONDS=1800
SESSION_MAX_SECONDS=28800
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_INTERVAL_SECONDS=1
MAX_DOWNLOAD_BYTES=26214400
MAX_HTML_BYTES=5242880
MAX_SESSIONS=100
LOGIN_ATTEMPTS_PER_MINUTE=5
CORS_ORIGINS=
DOCS_ENABLED=true
